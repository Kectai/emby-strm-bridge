<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Emby.StrmBridge</AssemblyName>
    <RootNamespace>Emby.StrmBridge</RootNamespace>
    <Version>0.2.2</Version>
    <Authors>Kectai</Authors>
    <Copyright>Copyright (c) 2026 Kectai</Copyright>
    <Description>Routes selected STRM playback through an in-process Emby gateway.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" GeneratePathProperty="true" />
    <PackageReference Include="MediaBrowser.Server.Core" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)embedded/0Harmony.dll.gz"
                      LogicalName="Emby.StrmBridge.Dependencies.0Harmony.dll.gz" />
    <EmbeddedResource Update="Localization/PluginStrings.zh-Hans.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>Emby.StrmBridge.Localization.PluginStringsZhHans.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization/PluginStrings.zh-Hant.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>Emby.StrmBridge.Localization.PluginStringsZhHant.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <UsingTask TaskName="CompressHarmonyDependency"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Path.GetDirectoryName(DestinationFile));
        using (var input = File.OpenRead(SourceFile))
        using (var output = File.Create(DestinationFile))
        using (var compressed = new GZipStream(output, CompressionLevel.Optimal))
        {
            input.CopyTo(compressed);
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PrepareEmbeddedHarmony" BeforeTargets="PrepareResources"
          Inputs="$(PkgLib_Harmony)/lib/net6.0/0Harmony.dll"
          Outputs="$(IntermediateOutputPath)embedded/0Harmony.dll.gz">
    <CompressHarmonyDependency
      SourceFile="$(PkgLib_Harmony)/lib/net6.0/0Harmony.dll"
      DestinationFile="$(IntermediateOutputPath)embedded/0Harmony.dll.gz" />
  </Target>
</Project>
