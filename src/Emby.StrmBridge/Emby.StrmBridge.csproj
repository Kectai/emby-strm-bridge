<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Emby.StrmBridge</AssemblyName>
    <RootNamespace>Emby.StrmBridge</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Safely bridges local STRM files to Emby media information and short-lived redirects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/**/*" />
    <EmbeddedResource Update="Localization/PluginStrings.zh-Hans.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>Emby.StrmBridge.Localization.PluginStringsZhHans.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization/PluginStrings.zh-Hant.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>Emby.StrmBridge.Localization.PluginStringsZhHant.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
</Project>
